<Window
    x:Class="QuantumPdfViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:QuantumPdfViewer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="QuantumPdfViewer"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="NavView" 
                        Background="#08080C"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="viewer" Content="PDF Viewer" Icon="Document" />
                <NavigationViewItem Tag="tools" Content="QDC Toolkit" Icon="Library" />
            </NavigationView.MenuItems>

            <!-- Main Frame for Navigation -->
            <Frame x:Name="RootFrame" Background="#13131A" />
        </NavigationView>
    </Grid>
</Window>
