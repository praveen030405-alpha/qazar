<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Meridian" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0C0C12</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#0C0C12</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/transparent_pixel</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">#0C0C12</item>
    </style>
    
    <style name="Theme.Meridian.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>